# ShellGame shell integration for Bash
# SHELLGAME_WRAPPER is set in the environment by the launcher

# Disable shell features that can interfere with the game.
unset PROMPT_COMMAND
set +o histexpand
shopt -u checkwinsize 2>/dev/null || true
shopt -s globasciiranges 2>/dev/null || true

# `$binary_path` is injected by Python. It may contain spaces and/or multiple argv parts.
# Store it as a bash argv array so we can execute it reliably (without fragile splitting).
declare -a SHELLGAME_BINARY_ARR
eval "SHELLGAME_BINARY_ARR=($binary_path)"

# Command forwarded from outside the game shell; empty for a plain launch.
# Python injects already-quoted tokens, which are valid bash source here, so
# this must NOT go through eval: the quoting would be parsed a second time and
# arguments containing quotes would lose them.
declare -a SHELLGAME_AUTOSTART_ARR
SHELLGAME_AUTOSTART_ARR=($autostart_args)

# Ensure SHELLGAME_FD_HOOK exists so scripts (e.g. buggy.sh) can invoke fd-hook directly
if [ -z "${SHELLGAME_FD_HOOK:-}" ] || [ ! -x "${SHELLGAME_FD_HOOK:-}" ]; then
    _sg_fd_hook="$(mktemp "${TMPDIR:-/tmp}/sg-fd-hook-XXXXXX.sh" 2>/dev/null || mktemp /tmp/sg-fd-hook-XXXXXX.sh)"
    printf '#!/bin/sh\nexec %s fd-hook "$@"\n' "$binary_path" > "$_sg_fd_hook"
    chmod 700 "$_sg_fd_hook"
    export SHELLGAME_FD_HOOK="$_sg_fd_hook"
    trap '[ -n "${_sg_fd_hook:-}" ] && rm -f "$_sg_fd_hook"' EXIT
fi

$dev_shortcuts

# Decode one base64-encoded protocol argument.
__shellgame_decode() {
    printf '%s' "$1" | base64 --decode
}

# Execute one closed protocol operation.
# Uses `builtin cd` to bypass user-facing cd hooks when the game teleports.
__shellgame_eval() {
    local stderr_file="$1"
    shift
    local version="${1:-}"
    local command="${2:-}"

    if [ "$version" != "v1" ]; then
        return 2
    fi
    shift 2

    case "$command" in
        cd)
            [ "$#" -eq 1 ] || return 2
            local destination
            destination="$(__shellgame_decode "$1")" || return 2
            builtin cd -- "$destination"
            ;;
        export)
            [ "$#" -eq 2 ] || return 2
            local name value
            name="$(__shellgame_decode "$1")" || return 2
            value="$(__shellgame_decode "$2")" || return 2
            [[ "$name" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || return 2
            printf -v "$name" '%s' "$value"
            export "$name"
            ;;
        echo)
            [ "$#" -eq 1 ] || return 2
            __shellgame_decode "$1"
            printf '\n'
            ;;
        pwd)
            [ "$#" -eq 0 ] || return 2
            command pwd
            ;;
        exit)
            [ "$#" -eq 0 ] || return 2
            rm -f "$stderr_file"
            [ -n "${_sg_fd_hook:-}" ] && rm -f "$_sg_fd_hook"
            builtin exit 0
            ;;
        *)
            return 2
            ;;
    esac
}

pwd() {
    command pwd
    # Record usage for game verification.
    # The workspace is only ever supplied by the game; never guess it.
    if [ -n "${SHELLGAME_WORKSPACE:-}" ] && [ -d "$SHELLGAME_WORKSPACE" ]; then
        touch "$SHELLGAME_WORKSPACE/.pwd_used"
    fi
}

# Level-specific `cd` wrapper hooks are injected here (generated from Python).
# The injected code must define a `cd()` function.
# If it does not, we provide a safe default `cd()` below.
$cd_hook

# Default cd implementation (used when no hook is injected).
if ! declare -F cd >/dev/null 2>&1; then
cd() {
    builtin cd "$@"
}
fi

shellgame() {
    local stderr_file
    stderr_file="$(mktemp)"

    # Detect if this is a remove command - we'll need to exit the subshell after success.
    local is_remove_cmd=0
    if [ "${1:-}" = "remove" ]; then
        is_remove_cmd=1
    fi

    # If the current working directory was deleted, relocate before running Python
    if [ ! -d "$PWD" ]; then
        if [ -n "${SHELLGAME_WORKSPACE:-}" ] && [ -d "$SHELLGAME_WORKSPACE" ]; then
            builtin cd -- "$SHELLGAME_WORKSPACE" 2>/dev/null || builtin cd /tmp 2>/dev/null || true
        else
            builtin cd /tmp 2>/dev/null || true
        fi
    fi

    # Execute the launcher as argv (array), never via eval/string splitting.
    "${SHELLGAME_BINARY_ARR[@]}" "$@" 2>"$stderr_file"
    local exit_code=$?

    if [ -f "$stderr_file" ]; then
        while IFS= read -r line; do
            # Keep exact output except for removing a single trailing CR.
            # Do NOT trim generally; it can corrupt legitimate stderr.
            line="${line%$'\r'}"

            # Only treat lines that start with the marker as directives.
            # This prevents leaking protocol lines to the user.
            if [[ "$line" == __SHELLGAME_EXEC__* ]]; then
                local protocol_payload="${line#__SHELLGAME_EXEC__}"
                # Intentional word splitting on the payload, but with globbing
                # disabled so a payload can never expand against the filesystem.
                set -f
                __shellgame_eval "$stderr_file" $protocol_payload
                set +f
            else
                echo "$line" >&2
            fi
        done < "$stderr_file"
    fi

    rm -f "$stderr_file"

    # If remove succeeded, exit the subshell cleanly.
    # We do this here (after processing stderr) rather than relying on a protocol directive,
    # because Click's confirmation prompt can interfere with stderr capture timing.
    if [ "$is_remove_cmd" = "1" ] && [ "$exit_code" = "0" ]; then
        [ -n "${_sg_fd_hook:-}" ] && rm -f "$_sg_fd_hook"
        builtin exit 0
    fi

    return $exit_code
}

_shellgame_completions()
{
  local cur subcmd
  COMPREPLY=()
  cur="${COMP_WORDS[COMP_CWORD]}"

  local commands="init hint submit skip status reset resume levels repeat show remove exit"

  if [ "$COMP_CWORD" -eq 1 ]; then
    if [[ "${cur}" == -* ]]; then
      COMPREPLY=( $(compgen -W "--help" -- "${cur}") )
    else
      COMPREPLY=( $(compgen -W "${commands}" -- "${cur}") )
    fi
    return 0
  fi

  subcmd="${COMP_WORDS[1]}"
  case "${subcmd}" in
    hint)
      COMPREPLY=( $(compgen -W "-r --repeat --help" -- "${cur}") )
      ;;
    repeat)
      COMPREPLY=( $(compgen -W "--section --level --help" -- "${cur}") )
      ;;
    show)
      COMPREPLY=( $(compgen -W "--section --level --help" -- "${cur}") )
      ;;
    submit)
      COMPREPLY=( $(compgen -f -- "${cur}") )
      ;;
    dev)
      if [ "$COMP_CWORD" -eq 2 ]; then
        COMPREPLY=( $(compgen -W "jump next prev reload start" -- "${cur}") )
      fi
      ;;
    *)
      ;;
  esac
}
complete -F _shellgame_completions shellgame sg g

# Export the function so it's available in the shell
export -f shellgame

# Autostart block (runs once when integration is sourced).
# This must be at the end so the shellgame function is already defined.
if [ -z "${SHELLGAME_AUTO_STARTED:-}" ]; then
    export SHELLGAME_AUTO_STARTED=1
    # A command typed outside the game shell (e.g. `shellgame resume 6.2`)
    # cannot run before this shell exists, so Python injects it here as argv
    # and it is replayed once the shell is up. Empty for a plain launch.
    if [ "${SHELLGAME_SUBSHELL_DEBUG:-}" = "1" ]; then
        echo "[shellgame][debug][bash] autostarting shellgame ${SHELLGAME_AUTOSTART_ARR[*]:-}..." >&2
        set -x
        shellgame ${SHELLGAME_AUTOSTART_ARR[@]+"${SHELLGAME_AUTOSTART_ARR[@]}"}
        { set +x; } 2>/dev/null || true
    else
        shellgame ${SHELLGAME_AUTOSTART_ARR[@]+"${SHELLGAME_AUTOSTART_ARR[@]}"}
    fi
fi

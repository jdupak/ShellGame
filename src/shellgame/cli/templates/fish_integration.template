# ShellGame shell integration for Fish
# SHELLGAME_WRAPPER is set in the environment by the launcher

# Define the binary path
# $binary_path is a space-separated list of quoted strings (e.g. "'python' 'script.py'")
# We set it without quotes so Fish parses it as a list.
set -gx SHELLGAME_BINARY $binary_path

# Ensure SHELLGAME_FD_HOOK exists so scripts (e.g. buggy.sh) can invoke fd-hook directly
if not set -q SHELLGAME_FD_HOOK; or not test -x "$SHELLGAME_FD_HOOK"
    set -g _sg_fd_hook (mktemp -t sg-fd-hook-XXXXXX.sh 2>/dev/null; or mktemp /tmp/sg-fd-hook-XXXXXX.sh)
    printf '#!/bin/sh\nexec %s fd-hook "$@"\n' "$binary_path" > "$_sg_fd_hook"
    chmod 700 "$_sg_fd_hook"
    set -gx SHELLGAME_FD_HOOK "$_sg_fd_hook"
    function __shellgame_cleanup_fd_hook --on-event fish_exit
        if set -q _sg_fd_hook; and test -f "$_sg_fd_hook"
            command rm -f "$_sg_fd_hook"
        end
    end
end

# Track whether we've already autostarted (to avoid double-start).
if not set -q SHELLGAME_AUTO_STARTED
    set -gx SHELLGAME_AUTO_STARTED 0
end

$dev_shortcuts

# Decode one base64-encoded protocol argument.
function __shellgame_decode
    printf "%s" "$argv[1]" | command base64 --decode
end

# Execute one closed protocol operation.
# Uses `builtin cd` to bypass user-facing cd hooks when the game teleports.
function __shellgame_eval
    set -l stderr_file "$argv[1]"
    set -e argv[1]

    if test (count $argv) -lt 2; or test "$argv[1]" != "v1"
        return 2
    end

    set -l command_name "$argv[2]"

    if test "$command_name" = "cd"; and test (count $argv) -eq 3
        set -l destination (__shellgame_decode "$argv[3]")
        or return 2
        builtin cd -- "$destination"
    else if test "$command_name" = "export"; and test (count $argv) -eq 4
        set -l name (__shellgame_decode "$argv[3]")
        or return 2
        set -l value (__shellgame_decode "$argv[4]")
        or return 2

        string match -rq '^[A-Za-z_][A-Za-z0-9_]*$' -- "$name"
        or return 2
        set -gx $name "$value"
    else if test "$command_name" = "echo"; and test (count $argv) -eq 3
        __shellgame_decode "$argv[3]"
        printf "\n"
    else if test "$command_name" = "pwd"; and test (count $argv) -eq 2
        command pwd
    else if test "$command_name" = "exit"; and test (count $argv) -eq 2
        rm -f "$stderr_file"
        if set -q _sg_fd_hook; and test -f "$_sg_fd_hook"
            command rm -f "$_sg_fd_hook"
        end
        exit 0
    else
        return 2
    end
end

function pwd
    command pwd
    # Record usage for game verification.
    # The workspace is only ever supplied by the game; never guess it.
    if test -n "$SHELLGAME_WORKSPACE" -a -d "$SHELLGAME_WORKSPACE"
        touch "$SHELLGAME_WORKSPACE/.pwd_used"
    end
end

# Level-specific `cd` wrapper hooks are injected here (generated from Python).
# The injected code should define a `cd` function.
$cd_hook

# Default cd implementation (used when no hook is injected).
if not functions -q cd
    function cd
        builtin cd $argv
    end
end

function shellgame
    # Create temp files for stderr processing
    set stderr_file (mktemp)

    # Detect if this is a remove command - we'll need to exit the subshell after success.
    set -l is_remove_cmd 0
    if test (count $argv) -ge 1; and test "$argv[1]" = "remove"
        set is_remove_cmd 1
    end

    # If the current working directory was deleted, relocate before running Python
    if not test -d "$PWD"
        if set -q SHELLGAME_WORKSPACE; and test -d "$SHELLGAME_WORKSPACE"
            builtin cd "$SHELLGAME_WORKSPACE" 2>/dev/null; or builtin cd /tmp 2>/dev/null
        else
            builtin cd /tmp 2>/dev/null
        end
    end

    # Run the actual command and capture stderr
    # Execute directly as a list (SHELLGAME_BINARY is a list)
    $SHELLGAME_BINARY $argv 2>$stderr_file
    set exit_code $status

    # Process stderr for shell commands and regular output
    if test -f "$stderr_file"
        while read -l line
            # Keep exact output except for removing a single trailing CR.
            # Do NOT trim generally; it can corrupt legitimate stderr.
            set line (string replace -r '\r$' '' -- "$line")

            # Anchored minimal protocol:
            # - only lines starting exactly with __SHELLGAME_EXEC__
            # - shell command is the remainder of the line
            if string match -rq '^__SHELLGAME_EXEC__' -- "$line"
                set protocol_payload (string replace -r '^__SHELLGAME_EXEC__' '' -- "$line")
                set protocol_words (string split " " -- "$protocol_payload")
                __shellgame_eval "$stderr_file" $protocol_words
            else
                echo "$line" >&2
            end
        end < $stderr_file
    end

    rm -f $stderr_file

    # If remove succeeded, exit the subshell cleanly.
    # We do this here (after processing stderr) rather than relying on a protocol directive,
    # because Click's confirmation prompt can interfere with stderr capture timing.
    if test $is_remove_cmd -eq 1; and test $exit_code -eq 0
        if set -q _sg_fd_hook; and test -f "$_sg_fd_hook"
            command rm -f "$_sg_fd_hook"
        end
        exit 0
    end

    return $exit_code
end

# Autocomplete for shellgame
function __fish_shellgame_needs_command
    set cmd (commandline -opc)
    if test (count $cmd) -eq 1
        return 0
    end
    return 1
end

complete -c shellgame -f -n "__fish_shellgame_needs_command" -a "init hint submit skip status reset repeat show remove exit"

# Autostart block (runs once when integration is sourced).
# This must be at the end so the shellgame function is already defined.
if test "$SHELLGAME_AUTO_STARTED" = "0"
    set -gx SHELLGAME_AUTO_STARTED 1
    shellgame
end

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# setuptools-scm
_version.py

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
# NOTE: Do not ignore *.spec — we commit `shellgame.spec` as part of the release build.

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
*.cover
*.py,cover
.hypothesis/
